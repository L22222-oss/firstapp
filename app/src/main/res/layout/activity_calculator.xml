<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/calculator_display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:maxLines="1"
        android:padding="20dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="52sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout style="@style/CalculatorRow">
            <Button android:id="@+id/button_clear" style="@style/CalculatorButton" android:text="C" />
            <Button android:id="@+id/button_sign" style="@style/CalculatorButton" android:text="+/-" />
            <Button android:id="@+id/button_percent" style="@style/CalculatorButton" android:text="%" />
            <Button android:id="@+id/button_divide" style="@style/CalculatorButton.Operator" android:text="÷" />
        </LinearLayout>
        <LinearLayout style="@style/CalculatorRow">
            <Button android:id="@+id/button_7" style="@style/CalculatorButton" android:text="7" />
            <Button android:id="@+id/button_8" style="@style/CalculatorButton" android:text="8" />
            <Button android:id="@+id/button_9" style="@style/CalculatorButton" android:text="9" />
            <Button android:id="@+id/button_multiply" style="@style/CalculatorButton.Operator" android:text="×" />
        </LinearLayout>
        <LinearLayout style="@style/CalculatorRow">
            <Button android:id="@+id/button_4" style="@style/CalculatorButton" android:text="4" />
            <Button android:id="@+id/button_5" style="@style/CalculatorButton" android:text="5" />
            <Button android:id="@+id/button_6" style="@style/CalculatorButton" android:text="6" />
            <Button android:id="@+id/button_subtract" style="@style/CalculatorButton.Operator" android:text="−" />
        </LinearLayout>
        <LinearLayout style="@style/CalculatorRow">
            <Button android:id="@+id/button_1" style="@style/CalculatorButton" android:text="1" />
            <Button android:id="@+id/button_2" style="@style/CalculatorButton" android:text="2" />
            <Button android:id="@+id/button_3" style="@style/CalculatorButton" android:text="3" />
            <Button android:id="@+id/button_add" style="@style/CalculatorButton.Operator" android:text="+" />
        </LinearLayout>
        <LinearLayout style="@style/CalculatorRow">
            <Button android:id="@+id/button_zero" style="@style/CalculatorButton.Zero" android:text="0" />
            <Button android:id="@+id/button_decimal" style="@style/CalculatorButton" android:text="." />
            <Button android:id="@+id/button_equals" style="@style/CalculatorButton.Operator" android:text="=" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
